# Port server Express (opsional, default: 4000)
PORT=4000

# URL publik Service A (Next.js) di Vercel atau localhost
SERVICE_A_URL="https://rosie-bakery.vercel.app"

# API Key rahasia untuk otentikasi ke Service A (harus sama persis dengan SERVICE_API_KEY di root Next.js)
SERVICE_API_KEY="rosie_internal_api_key_secret_12345"
