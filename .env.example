# Database connection string ke Neon PostgreSQL (disarankan endpoint berakhiran -pooler)
DATABASE_URL="postgresql://user:password@ep-sample-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Secret key untuk enkripsi JWT session cookie rosie_session (minimal 32 karakter)
AUTH_SECRET="ganti-dengan-kunci-rahasia-jwt-minimal-32-karakter-acak"

# API Key rahasia untuk komunikasi internal Service B ke Service A
SERVICE_API_KEY="rosie_internal_api_key_secret_12345"
